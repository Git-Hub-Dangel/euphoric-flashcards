{
    "name": "euphoric-flashcards",
    "version": "1.4.1",
    "description": "Own your language, don't memorise it. A spaced-repetition system built exclusively for effective language learning.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "obsidian",
        "flashcards",
        "spaced-repetition",
        "language",
        "learning"
    ],
    "author": "Daniel Khansa",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "esbuild": "^0.25.0",
        "moment": "^2.30.1",
        "obsidian": "^1.8.0",
        "typescript": "^5.7.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^3.0.0"
    }
}
